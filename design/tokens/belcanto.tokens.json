{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Belcanto exploratory tokens",
    "status": "EXPLORATORY / NON-NORMATIVE",
    "version": "0.1.0",
    "date": "2026-07-29"
  },
  "color": {
    "dark": {
      "background": {
        "canvas": { "$type": "color", "$value": "#09080F" },
        "sunken": { "$type": "color", "$value": "#0D0C15" },
        "surface": { "$type": "color", "$value": "#14121E" },
        "raised": { "$type": "color", "$value": "#1B1828" }
      },
      "border": {
        "default": { "$type": "color", "$value": "#362F48" },
        "strong": { "$type": "color", "$value": "#514769" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#F7F4FB" },
        "secondary": { "$type": "color", "$value": "#D2CCDC" },
        "muted": { "$type": "color", "$value": "#ABA3BA" },
        "inverse": { "$type": "color", "$value": "#150F20" }
      },
      "action": {
        "primary": { "$type": "color", "$value": "#9C6FFF" },
        "primaryPressed": { "$type": "color", "$value": "#8658EC" },
        "focus": { "$type": "color", "$value": "#B99BFF" }
      },
      "accent": {
        "community": { "$type": "color", "$value": "#E84F92" }
      },
      "feedback": {
        "success": { "$type": "color", "$value": "#42C297" },
        "warning": { "$type": "color", "$value": "#EFB457" },
        "danger": { "$type": "color", "$value": "#EB5B70" }
      }
    },
    "light": {
      "background": {
        "canvas": { "$type": "color", "$value": "#FAF7FC" },
        "surface": { "$type": "color", "$value": "#FFFDFE" },
        "raised": { "$type": "color", "$value": "#F4EFF8" }
      },
      "border": {
        "default": { "$type": "color", "$value": "#DED5E8" }
      },
      "text": {
        "primary": { "$type": "color", "$value": "#191225" },
        "muted": { "$type": "color", "$value": "#675D75" }
      },
      "action": {
        "primary": { "$type": "color", "$value": "#7645DF" }
      }
    }
  },
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "22px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "font": {
    "size": {
      "caption": { "$type": "dimension", "$value": "12px" },
      "label": { "$type": "dimension", "$value": "14px" },
      "body": { "$type": "dimension", "$value": "16px" },
      "title3": { "$type": "dimension", "$value": "20px" },
      "title2": { "$type": "dimension", "$value": "24px" },
      "title1": { "$type": "dimension", "$value": "32px" },
      "display": { "$type": "dimension", "$value": "40px" }
    },
    "family": {
      "body": { "$type": "fontFamily", "$value": "UNRESOLVED_BODY" },
      "display": { "$type": "fontFamily", "$value": "UNRESOLVED_DISPLAY" }
    }
  },
  "motion": {
    "duration": {
      "quick": { "$type": "duration", "$value": "120ms" },
      "standard": { "$type": "duration", "$value": "200ms" },
      "expressive": { "$type": "duration", "$value": "320ms" },
      "celebratory": { "$type": "duration", "$value": "480ms" }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [0.4, 0, 1, 1]
      }
    }
  },
  "interaction": {
    "minimumTarget": { "$type": "dimension", "$value": "44px" }
  }
}
